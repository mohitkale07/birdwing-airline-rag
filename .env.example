NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# JSON list of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Local PostgreSQL connection for the planned API/database layer
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/birdwing_rag

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# Application JWT signing
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ISSUER=birdwing-api
JWT_AUDIENCE=birdwing-client
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email configuration
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=BirdWing Airlines

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true

# Frontend verification URL
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_EXPIRE_MINUTES=30

# Set false only for local HTTP development.
AUTH_COOKIE_SECURE=false