NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Local PostgreSQL connection for the planned API/database layer
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/birdwing_rag

# Google Sign-In token verification and application JWT signing
GOOGLE_CLIENT_ID=your_google_oauth_client_id
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
